        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "add935bb-617b-42fb-9410-a4bdd3b31978"
      }
    },
    "owner": "mtmb",
    "plugins": [
      "expo-router"
    ]
  }
}
